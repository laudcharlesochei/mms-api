# Copy to .env (never commit it). Spring reads these as environment variables.
SPRING_PROFILES_ACTIVE=local
AUTH_MODE=local
JWT_SECRET=change-me-to-a-long-random-string
NOTES_ENCRYPTION_KEY=          # openssl rand -base64 32
CORS_ALLOWED_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
ADMIN_EMAIL=admin@mms.local
ADMIN_PASSWORD=ChangeMe123!
SEED_DEMO_DATA=true
EDIT_WINDOW_DAYS=14
# Entra ID (AUTH_MODE=entra)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_AUDIENCE=api://mms-api
ENTRA_API_SCOPE=api://mms-api/access_as_user
# Email (optional)
MAIL_ENABLED=false
MAIL_FROM=ga-mms@dundee.ac.uk
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_SEND_TO_STUDENT=false
# Jobs (optional)
REMINDERS_ENABLED=false
RETENTION_ENABLED=false
RETENTION_YEARS=6
FEATURE_MESSAGING=true
